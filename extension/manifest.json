{
  "manifest_version": 3,
  "name": "SEO God Mode: SEO, AEO & GEO Checker",
  "short_name": "SEO God Mode",
  "version": "1.3.0",
  "description": "Rate a site for SEO, AEO and AI search (GEO): plain summary, step-by-step fixes, a fix prompt to copy, and before/after proof.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Rate this site (SEO / AEO / GEO)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "homepage_url": "https://github.com/F0rger123/CLAUDE-SEO-GOD-MODE"
}
