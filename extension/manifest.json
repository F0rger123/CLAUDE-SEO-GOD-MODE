{
  "manifest_version": 3,
  "name": "CLAUDE SEO GOD MODE",
  "short_name": "SEO God Mode",
  "version": "1.0.0",
  "description": "SEO, AEO and GEO checks for any page, step-by-step fixes, ready-to-paste Claude prompts, and before/after proof. Runs locally.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Scan this page (SEO / AEO / GEO)", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
